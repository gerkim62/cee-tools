# ==============================================================================
# Ask Saka Backend - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY INFRASTRUCTURE CREDENTIALS (Strictly Required - No Defaults)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Supabase, Neon, AWS RDS, or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sakahub_rag

# OpenRouter API key for LLM synthesis, embeddings, context retrieval, and reranking
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# Qdrant cluster endpoint (e.g. https://xyz.eu-central.aws.cloud.qdrant.io:6333)
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333

# Qdrant API key (required for cloud-managed clusters)
QDRANT_API_KEY=your-qdrant-api-key

# ------------------------------------------------------------------------------
# 2. SERVER NETWORKING (Optional - Defaults Provided)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 3. AI MODELS (Optional - Defaults Provided)
# ------------------------------------------------------------------------------
# Final Answer Synthesis & Citations — Gemini 2.5 Flash: frontier intelligence,
# built-in hybrid reasoning, 1M context, guaranteed JSON mode via Google routing.
# Override with anthropic/claude-sonnet-4 for maximum verbatim citation precision.
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash

# Chunk Dense Embeddings — $0.02/1M tokens, 1536 dims, MTEB gold standard
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# Anthropic Contextual Retrieval Chunk Situating — same fast model for batch sync
OPENROUTER_CONTEXT_MODEL=google/gemini-2.5-flash

# Cross-Encoder Reranker — Cohere v3.5 handles tables, tariffs, Swahili/English
OPENROUTER_RERANK_MODEL=cohere/rerank-v3.5

# ------------------------------------------------------------------------------
# 4. VECTOR COLLECTION BASE (Optional - Defaults Provided)
# ------------------------------------------------------------------------------
# Automatically scoped by embedding model (e.g. saka_articles_openai_text_embedding_3_small)
QDRANT_COLLECTION_BASE=saka_articles

# ------------------------------------------------------------------------------
# 5. TUNING & RAG HYPERPARAMETERS (Optional - Defaults Provided)
# ------------------------------------------------------------------------------
SYNC_LOCK_TTL_MINUTES=3
CHUNK_SIZE=512
CHUNK_OVERLAP=75
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=5
