{
  "$schema": "./backend/node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/releases/**",
    "**/*.json"
  ]
}
